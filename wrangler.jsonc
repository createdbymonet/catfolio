{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catfolio",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "env": {
    "development": {
      "name": "catfolio-development"
    },
    "production": {
      "name": "catfolio"
    }
  }
}